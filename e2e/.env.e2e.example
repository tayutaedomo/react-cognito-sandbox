# ==========================================
# E2E テスト用設定
# Playwright が実 Cognito にアクセスするためのユーザー情報
# ==========================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Password123!

# TOTP 登録済みの専用テストユーザーで MFA E2E を実行する場合のみ設定。
# 初回登録時の Base32 シークレット (コードや otpauth URI ではない)。Git 管理禁止。
TEST_USER_TOTP_SECRET=

# OPTIONAL 用の専用ユーザー。test:e2e:mfa-optional が登録・設定を変更する。
# 開始時は TOTP 未登録または無効。通常のテストユーザーとは分ける。
MFA_OPTIONAL_USER_EMAIL=
MFA_OPTIONAL_USER_PASSWORD=

# 復旧 POC の専用ユーザー。管理者操作で MFA 設定と全セッションを変更する。
# mfa-recovery- で始まる example.com のユーザーを使用する。
MFA_RECOVERY_USER_EMAIL=
MFA_RECOVERY_USER_PASSWORD=
MFA_RECOVERY_USER_POOL_ID=
MFA_RECOVERY_AWS_REGION=
MFA_RECOVERY_AWS_PROFILE=

# 信頼するデバイス POC 専用ユーザー。MFA OPTIONAL のプールで使用する。
# テストが TOTP を登録し、シークレットは実行中のメモリーだけで使う。
MFA_DEVICE_USER_EMAIL=
MFA_DEVICE_USER_PASSWORD=
