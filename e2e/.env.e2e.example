# ==========================================
# E2E テスト用設定
# Playwright が実 Cognito にアクセスするためのユーザー情報
# ==========================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Password123!

# TOTP 登録済みの専用テストユーザーで MFA E2E を実行する場合のみ設定。
# 初回登録時の Base32 シークレット (コードや otpauth URI ではない)。Git 管理禁止。
TEST_USER_TOTP_SECRET=
