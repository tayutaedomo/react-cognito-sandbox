# メール MFA POC の準備用。実アドレス・パスワードは .env だけに記載する。
MFA_EMAIL_FROM=
MFA_EMAIL_TO=
# 専用テストユーザーのパスワード。ユーザー作成時に設定する。
MFA_EMAIL_USER_PASSWORD=
MFA_EMAIL_USER_POOL_ID=

# SMS サンドボックス用。日本の携帯番号を +81 形式で設定する。
MFA_SMS_TO=
# サンドボックス確認時のみ設定。確認後は削除する。
MFA_SMS_VERIFY_CODE=
# 未指定時は既存のメール MFA 専用ユーザー（MFA_EMAIL_TO）を使用する。
MFA_SMS_USER_EMAIL=
