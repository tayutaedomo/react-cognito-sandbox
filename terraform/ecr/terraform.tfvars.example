# ==============================================================================
# Terraform Variables Example (ECR)
# ==============================================================================
# このファイルは ECR 用の `terraform.tfvars` のテンプレートです。

# 1. プロジェクト名
# 作成される ECR リポジトリ名 (<project_name>-backend) として使用されます。
# 一貫性のため、app 側 (terraform/app) の設定と同じ名前にしてください。
project_name = "react-auth-poc"
