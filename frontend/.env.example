# ローカル開発用モック設定
# true にすると AWS (Cognito/API Gateway) に繋がず、MockAuthProvider と localhost:8000 を使用します
VITE_USE_MOCK_COGNITO=true

# AWS 本番環境用設定 (VITE_USE_MOCK_COGNITO=false の場合に使用)
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=react-auth-xxxxx
VITE_API_ENDPOINT=https://xxxxx.execute-api.ap-northeast-1.amazonaws.com

