{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:unit": "vitest run unit",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "cd .. && frontend/node_modules/.bin/oxfmt -c .oxfmtrc.json \"frontend/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"e2e/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terraform/tests/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"scripts/**/*.{js,ts,mjs}\"",
    "format:check": "cd .. && frontend/node_modules/.bin/oxfmt -c .oxfmtrc.json --check \"frontend/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"e2e/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terraform/tests/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"scripts/**/*.{js,ts,mjs}\""
  },
  "dependencies": {
    "aws-amplify": "^6.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "0.72.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
